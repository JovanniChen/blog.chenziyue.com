// 内容区宽度：大屏用更宽的值减少左右留白，可按需改
$content-width = 1100px
$content-width-medium = 900px

.flex-container
    width $content-width
    max-width 100%
    margin 0 auto

html
    font-size 18px

@media (max-width: 1600px)
    html
        font-size 18px
    .flex-container
        width $content-width

@media (max-width: 1200px)
    html
        font-size 18px
    .flex-container
        width $content-width-medium

@media (max-width: 688px)
    .flex-container
        display block
        width calc(100% - 48px)
        padding-left 24px
        padding-right 24px
